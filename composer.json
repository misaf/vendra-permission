{
    "name": "misaf/vendra-permission",
    "description": "Role and permission management for Vendra, built on top of Spatie Permission",
    "keywords": [
        "laravel",
        "filamentphp",
        "misaf",
        "vendra",
        "permission"
    ],
    "homepage": "https://github.com/misaf/vendra-permission",
    "license": "MIT",
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "type": "vendra-module",
    "require": {
        "php": "^8.4",
        "awcodes/filament-badgeable-column": "^4.0",
        "laravel/pennant": "^1.24",
        "misaf/filament-jalali": "^5.1.4",
        "misaf/vendra-support": "self.version",
        "spatie/laravel-package-tools": "^1.93.1",
        "spatie/laravel-permission": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Misaf\\VendraPermission\\": "src/",
            "Misaf\\VendraPermission\\Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\VendraPermission\\Database\\Factories\\": "database/factories/",
            "Misaf\\VendraPermission\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\VendraPermission\\Providers\\PermissionServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "support": {
        "issues": "https://github.com/misaf/vendra-permission/issues",
        "source": "https://github.com/misaf/vendra-permission"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
